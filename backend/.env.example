# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# SECRET key (sb_secret_...) or legacy service_role key.
# Backend ONLY. Never put this in the frontend or commit it.
SUPABASE_SECRET_KEY=your-supabase-secret-key

PORT=5000

# Comma-separated list of frontend origins allowed to call the API locally
CORS_ORIGIN=http://localhost:5173

# Set to "development" locally to see stack traces in error responses
NODE_ENV=development
