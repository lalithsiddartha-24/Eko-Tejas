# Frontend settings. Copy this file to `.env.local` (git ignores it) and fill in.
# Anything starting with VITE_ is visible in the browser, so ONLY public values here.
#
# Where to find them: Supabase Dashboard -> Project Settings -> API Keys
# Use the PUBLISHABLE key (sb_publishable_...). NEVER the secret key.
# These are needed only for the admin login (/admin). The public site works without them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
